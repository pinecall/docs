# Where an in-repo link points, once the page is on the site.
BY_SOURCE = {page.source: page.at for page in PAGES}
# The same, keyed by the file name alone, for sibling links like [the-cli.md](the-cli.md).
BY_NAME: dict[str, list[str]] = {}
for page in PAGES:
    BY_NAME.setdefault(Path(page.source).name, []).append(page.at)


def main() -> int:
    """Copy every page in, rewrite what only made sense inside a repo, and report."""
    missing = [page.source for page in PAGES if not (TREES / page.source).is_file()]
    if missing:
        print("these sources are not there:", *missing, sep="\n  ", file=sys.stderr)
        return 1

    for folder in ("start", "agent", "operate", "run", "api", "wire", "inside", "images"):
        shutil.rmtree(HERE / folder, ignore_errors=True)

    for page in PAGES:
        body = (TREES / page.source).read_text(encoding="utf-8")
        landing = HERE / f"{page.at}.mdx"
        landing.parent.mkdir(parents=True, exist_ok=True)
        landing.write_text(_as_mdx(page, body), encoding="utf-8")

    copied = _copy_images()
    print(f"{len(PAGES)} pages, {copied} images")
    return 0


def _as_mdx(page: Page, body: str) -> str:
    """One repo's markdown as one Mintlify page: frontmatter, no repeated H1, links that work."""
    body = _drop_the_title(body)
    body = _links(body, Path(page.source).parent)
    body = _images(body)
    body = _escape_for_mdx(body)
    front = "\n".join((
        "---",
        f'title: "{page.title}"',
        f'description: "{page.blurb}"',
        # The page a reader edits is the one in the repo, never this copy.
        f'"og:see_also": "https://github.com/pinecall/{page.source}"',
        "---",
        "",
    ))
    return front + body.lstrip("\n")


def _drop_the_title(body: str) -> str:
    """Mintlify draws the H1 from the frontmatter; a second one reads as a repeated heading."""
    return re.sub(r"\A(?:\s*\n)*# .*\n", "", body, count=1)


def _links(body: str, home: Path) -> str:
    """A link that meant one repo's file has to mean this site's path, or it 404s."""

    def moved(match: re.Match[str]) -> str:
        text, target = match.group(1), match.group(2)
        if target.startswith(("http", "#", "mailto:")):
            return match.group(0)
        anchor = ""
        if "#" in target:
            target, anchor = target.split("#", 1)
            anchor = "#" + anchor
        if not target:
            return match.group(0)
        here = str((home / target).as_posix()).replace("../", "")
        for candidate in (here, str(Path(home, target).as_posix())):
            if candidate in BY_SOURCE:
                return f"[{text}](/{BY_SOURCE[candidate]}{anchor})"
        where = BY_NAME.get(Path(target).name)
        if where and len(where) == 1:
            return f"[{text}](/{where[0]}{anchor})"
        # Not a page here — send the reader to the file itself, on GitHub.
        repo, _, rest = str((home / target).as_posix()).partition("/")
        return f"[{text}](https://github.com/pinecall/{repo}/blob/main/{rest}{anchor})"

    return re.sub(r"\[([^\]]*)\]\(([^)\s]+)\)", moved, body)


# A `<picture>` with `prefers-color-scheme` follows the OPERATING SYSTEM, which is right in a
# markdown file on GitHub and wrong here: this site has its own light/dark toggle, and an image
# that ignores it shows a white screenshot on a dark page. Mintlify's two-image pattern follows
# the toggle. MDX is JSX besides, so every void tag has to close itself.
PICTURE = re.compile(
    r"<picture>\s*"
    r"<source\s+srcset=\"([^\"]+)\"[^>]*>\s*"
    r"<img\s+src=\"([^\"]+)\"\s+alt=\"([^\"]*)\"[^>]*>\s*"
    r"</picture>",
    re.S,
)


def _images(body: str) -> str:
    """The screenshots travel with the page, and follow this site's theme rather than the OS's."""
    body = body.replace("docs/images/", "/images/")
    body = re.sub(r"(?<!/)(?<!\w)images/", "/images/", body)
    body = body.replace("//images/", "/images/")

    def framed(match: re.Match[str]) -> str:
        dark, light, alt = match.group(1), match.group(2), match.group(3)
        return (
            "<Frame>\n"
            f'  <img src="{light}" alt="{alt}" className="block dark:hidden" />\n'
            f'  <img src="{dark}" alt="{alt}" className="hidden dark:block" />\n'
            "</Frame>"
        )

    return PICTURE.sub(framed, body)


# MDX reads `{` as an expression and `<` as a tag. Inside code that is fine; in prose it is a build
# error on a page whose markdown was never written for MDX. So the code has to be found exactly —
# a fence that pairs by its own length, and an inline span that may run over a line break and may
# be opened by any number of backticks. A cheaper `` `[^`\n]*` `` gets both of those wrong, and the
# two pages it got wrong were the two that failed to build.
FENCE_OPENS = re.compile(r"^(?P<indent>[ \t]*)(?P<bars>`{3,}|~{3,})(?P<info>[^\n]*)$")


def _code_and_prose(body: str) -> list[tuple[bool, str]]:
    """The document cut into runs, each marked: True is code and is never touched."""
    out: list[tuple[bool, str]] = []
    lines = body.split("\n")
    at, prose = 0, []
    while at < len(lines):
        opening = FENCE_OPENS.match(lines[at])
        if opening:
            block = [lines[at]]
            bars = opening.group("bars")
            at += 1
            while at < len(lines):
                block.append(lines[at])
                closing = FENCE_OPENS.match(lines[at])
                at += 1
                if closing and closing.group("bars")[0] == bars[0] and len(closing.group("bars")) >= len(bars) and not closing.group("info").strip():
                    break
            out.append((False, "\n".join(prose) + ("\n" if prose else "")))
            prose = []
            out.append((True, "\n".join(block) + "\n"))
            continue
        prose.append(lines[at])
        at += 1
    out.append((False, "\n".join(prose)))
    return [(code, text) for code, text in out if text]


SPAN = re.compile(r"(?<!`)(`+)(?!`)(.+?)(?<!`)\1(?!`)", re.S)


def _escape_for_mdx(body: str) -> str:
    """Leave code exactly as it is; make prose safe for the MDX parser."""
    return "".join(
        text if is_code else _outside_spans(text)
        for is_code, text in _code_and_prose(body)
    )


def _outside_spans(text: str) -> str:
    """Tame the prose around every inline code span, and the spans a table would split."""
    out, last = [], 0
    for span in SPAN.finditer(text):
        out.append(_tame(text[last:span.start()]))
        out.append(_span_safe(span.group(0)))
        last = span.end()
    out.append(_tame(text[last:]))
    return "".join(out)


def _span_safe(span: str) -> str:
    """Two things a code span survives in markdown and does not survive here."""
    # A `|` inside a code span still splits a table cell: GFM cuts cells before it parses inline.
    span = span.replace("|", "\\|")
    # A code span may run over a line break, and CommonMark says that break IS a space. MDX does not
    # shield it: braces on the second line reach the expression parser and the page will not build.
    return re.sub(r"\s*\n\s*", " ", span)


# The only tags this site emits. Everything else that looks like a tag in these files is prose a
# person wrote — `&lt;slug&gt;` in a usage line, a generic in a field list — and MDX would read each
# of them as an unclosed JSX element and refuse the page.
OURS = (
    "Frame", "img", "Note", "Tip", "Warning", "Info", "Card", "Columns", "Steps", "Step",
    "Accordion", "AccordionGroup", "Tabs", "Tab", "CodeGroup", "Update", "br", "details", "summary",
)
A_TAG = re.compile(r"<(?!/?(?:" + "|".join(OURS) + r")\b)")


def _tame(prose: str) -> str:
    """Prose only — never a fence, never an inline span."""
    # `<!-- generated:begin -->` marks what the schema wrote. MDX has no HTML comments, and the
    # marker means nothing to a reader.
    prose = re.sub(r"<!--.*?-->", "", prose, flags=re.S)
    prose = A_TAG.sub("&lt;", prose)
    return prose.replace("{", "&#123;").replace("}", "&#125;")


def _copy_images() -> int:
    """Only what a page actually shows."""
    source = TREES / "runtime/docs/images"
    if not source.is_dir():
        return 0
    shutil.copytree(source, HERE / "images")
    return sum(1 for _ in (HERE / "images").rglob("*.png"))


if __name__ == "__main__":
    raise SystemExit(main())
