#!/usr/bin/env python3
"""The pages, taken from the three repos. This site writes no prose of its own.

Every page here is a `.md` that lives beside the code it describes, so editing the code and
editing its page is one commit. Run this, and the site is what the repos say today.
"""

from __future__ import annotations

import re
import shutil
import sys
from dataclasses import dataclass
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
TREES = HERE.parent  # ~/pinecall-v2


@dataclass(frozen=True)
class Page:
    """One markdown file, and where it lands on the site."""

    source: str          # <repo>/<path>, relative to ~/pinecall-v2
    at: str              # the site path, without .mdx
    title: str
    blurb: str


